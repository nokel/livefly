{
  "manifest_version": 3,
  "name": "livefly",
  "version": "1.3.1",
  "description": "Edit any website like layers in a design tool. Move, resize, hide and restyle regions, write custom CSS, and auto-close popups. Everything persists per site.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "livefly",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "dom.js", "popups.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-editor": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open or close the livefly editor on this page"
    },
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume livefly edits on this site"
    }
  }
}
